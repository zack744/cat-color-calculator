---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CatColorCalculator from '../components/CatColorCalculator.astro';

const title = "Persian Cat Color Calculator - Predict Kitten Colors";
const description = "Persian cat color calculator. Predict Persian kitten coat colors including dilute, bicolor, calico, and smoke. Free genetics tool.";
---
<Layout title={title} description={description}>
  <Header active="breeds" />
  <main class="max-w-container-max mx-auto px-lg md:px-xl py-xl space-y-xl">
<!-- Layer 1: H1 & Breed Calculator -->
<section class="mb-xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-lg items-start">
<div class="lg:col-span-5 flex flex-col gap-md">
<p class="text-sm font-semibold text-primary uppercase tracking-wide">4-gene model</p>
<h1 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-on-surface">Persian Cat Color Calculator</h1>
<p class="text-body-lg text-on-surface-variant leading-relaxed">
                        Shared Mendelian calculator (B, A, O, D). White spotting (bicolor/calico), colorpoint, and longhair modifiers are not calculated — notes only.
                    </p>
</div>
<div class="lg:col-span-7">
  <CatColorCalculator
    variant="breed"
    breed="persian"
    note="Shared B/A/O/D model. White spotting & colorpoint not calculated."
  />
</div>
</div>
</section>
<!-- Layer 2: Common Colors & Genetics -->
<section class="mb-xl grid grid-cols-1 lg:grid-cols-12 gap-xl">
<div class="lg:col-span-7">
<h2 class="text-headline-md font-headline-md text-on-surface mb-lg flex items-center gap-2">
<span class="material-symbols-outlined text-primary">palette</span>
                    Common Persian Colors
                </h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-md">
<div class="tonal-layer-1 rounded-xl overflow-hidden group">
<div class="h-40 bg-cover bg-center" style="background-image: url('/images/cats/persian/0.jpg')" role="img" aria-label="White longhair Persian cat in soft studio light"></div>
<div class="p-md">
<h3 class="font-bold text-on-surface">Solid White</h3>
<p class="text-label-sm text-on-surface-variant mt-xs leading-snug">Classic Persian white longhair — dominant white or high-grade spotting can produce this look.</p>
</div>
</div>
<div class="tonal-layer-1 rounded-xl overflow-hidden group">
<div class="h-40 bg-cover bg-center" style="background-image: url('/images/cats/persian/1.jpg')" role="img" aria-label="Silver shaded Persian kitten between houseplants"></div>
<div class="p-md">
<h3 class="font-bold text-on-surface">Silver Shaded</h3>
<p class="text-label-sm text-on-surface-variant mt-xs leading-snug">Shimmering white undercoat with fine tipping — inhibitor gene expression.</p>
</div>
</div>
<div class="tonal-layer-1 rounded-xl overflow-hidden group">
<div class="h-40 bg-cover bg-center" style="background-image: url('/images/cats/tortoiseshell/0.jpg')" role="img" aria-label="Tortoiseshell and white cat with green eyes"></div>
<div class="p-md">
<h3 class="font-bold text-on-surface">Calicos &amp; Torties</h3>
<p class="text-label-sm text-on-surface-variant mt-xs leading-snug">Black, red, and white mosaics — X-linked orange gene, almost always female.</p>
</div>
</div>
<div class="tonal-layer-1 rounded-xl overflow-hidden group">
<div class="h-40 bg-cover bg-center" style="background-image: url('/images/cats/blue-cream/0.jpg')" role="img" aria-label="Blue-cream dilute tortie tabby cat outdoors"></div>
<div class="p-md">
<h3 class="font-bold text-on-surface">Dilutes (Blue-Cream)</h3>
<p class="text-label-sm text-on-surface-variant mt-xs leading-snug">Pastel blue and cream patches — dilute path of tortie genetics.</p>
</div>
</div>
</div>
</div>
<div class="lg:col-span-5">
<div class="bg-surface-container p-lg rounded-xl h-full border border-outline-variant/30">
<h2 class="text-headline-md font-headline-md text-on-surface mb-lg flex items-center gap-2">
<span class="material-symbols-outlined text-primary">dns</span>
                        Persian Coat Genetics
                    </h2>
<ul class="space-y-lg">
<li class="flex gap-md">
<div class="w-10 h-10 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold">1</div>
<div>
<h4 class="font-bold text-on-surface">The Polygenes Factor</h4>
<p class="text-body-md text-on-surface-variant">Unlike short-haired breeds, Persians rely on multiple genes to maintain their distinctive ultra-long 'peaked' coat texture.</p>
</div>
</li>
<li class="flex gap-md">
<div class="w-10 h-10 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold">2</div>
<div>
<h4 class="font-bold text-on-surface">The Dilute Gene (d/d)</h4>
<p class="text-body-md text-on-surface-variant">Recessive dilution turns Black into Blue and Red into Cream. Both parents must carry the gene to produce dilute kittens.</p>
</div>
</li>
<li class="flex gap-md">
<div class="w-10 h-10 shrink-0 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold">3</div>
<div>
<h4 class="font-bold text-on-surface">Bicolor Masking</h4>
<p class="text-label-md bg-secondary-container text-on-secondary-container inline-block px-2 rounded mt-xs">Advanced genetic alert</p>
<p class="text-body-md text-on-surface-variant mt-1">High-grade white spotting can mask the cat's underlying tabby pattern, often appearing as 'ghost markings' in kittens.</p>
</div>
</li>
</ul>
</div>
</div>
</section>
<!-- Layer 3: Example Outcomes -->
<section class="mb-xl">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-lg gap-md">
<div>
<h2 class="text-headline-md font-headline-md text-on-surface">Persian Example Outcomes</h2>
<p class="text-on-surface-variant">Common breeding pairings and their statistical probability.</p>
</div>
<div class="flex gap-sm">
<button class="bg-surface-container hover:bg-surface-container-high p-md rounded-full transition-colors">
<span class="material-symbols-outlined">chevron_left</span>
</button>
<button class="bg-primary text-on-primary p-md rounded-full hover:bg-primary-container transition-colors shadow-sm">
<span class="material-symbols-outlined">chevron_right</span>
</button>
</div>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-md">
<!-- Pairing Card 1 -->
<div class="tonal-layer-1 p-md rounded-xl hover:scale-[1.02] transition-transform cursor-pointer">
<div class="flex items-center justify-between mb-md">
<div class="flex -space-x-2">
<div class="w-10 h-10 rounded-full border-2 border-white bg-on-surface"></div>
<div class="w-10 h-10 rounded-full border-2 border-white bg-red-400"></div>
</div>
<span class="text-label-sm font-bold text-primary">High Prob.</span>
</div>
<h4 class="font-bold text-on-surface mb-xs">Black × Red Pairing</h4>
<p class="text-label-sm text-on-surface-variant mb-md">Expected: 50% Tortoiseshell (Females)</p>
<div class="w-full bg-surface-container rounded-full h-2">
<div class="bg-primary h-2 rounded-full" style="width: 50%"></div>
</div>
</div>
<!-- Pairing Card 2 -->
<div class="tonal-layer-1 p-md rounded-xl hover:scale-[1.02] transition-transform cursor-pointer">
<div class="flex items-center justify-between mb-md">
<div class="flex -space-x-2">
<div class="w-10 h-10 rounded-full border-2 border-white bg-blue-300"></div>
<div class="w-10 h-10 rounded-full border-2 border-white bg-blue-300"></div>
</div>
<span class="text-label-sm font-bold text-primary">Illustrative</span>
</div>
<h4 class="font-bold text-on-surface mb-xs">Blue × Blue Pairing</h4>
<p class="text-label-sm text-on-surface-variant mb-md">Expected: 100% Blue Kittens</p>
<div class="w-full bg-surface-container rounded-full h-2">
<div class="bg-primary h-2 rounded-full" style="width: 100%"></div>
</div>
</div>
<!-- Pairing Card 3 -->
<div class="tonal-layer-1 p-md rounded-xl hover:scale-[1.02] transition-transform cursor-pointer">
<div class="flex items-center justify-between mb-md">
<div class="flex -space-x-2">
<div class="w-10 h-10 rounded-full border-2 border-white bg-gray-500"></div>
<div class="w-10 h-10 rounded-full border-2 border-white bg-orange-200"></div>
</div>
<span class="text-label-sm font-bold text-primary">Complex Outcome</span>
</div>
<h4 class="font-bold text-on-surface mb-xs">Blue × Cream Pairing</h4>
<p class="text-label-sm text-on-surface-variant mb-md">Expected: Blue-Cream &amp; Cream</p>
<div class="w-full bg-surface-container rounded-full h-2">
<div class="bg-primary h-2 rounded-full" style="width: 25%"></div>
</div>
</div>
<!-- Pairing Card 4 -->
<div class="tonal-layer-1 p-md rounded-xl hover:scale-[1.02] transition-transform cursor-pointer">
<div class="flex items-center justify-between mb-md">
<div class="flex -space-x-2">
<div class="w-10 h-10 rounded-full border-2 border-white bg-stone-300"></div>
<div class="w-10 h-10 rounded-full border-2 border-white bg-red-600"></div>
</div>
<span class="text-label-sm font-bold text-primary">Low Prob.</span>
</div>
<h4 class="font-bold text-on-surface mb-xs">Smoke × Solid Red</h4>
<p class="text-label-sm text-on-surface-variant mb-md">Expected: Cameo (Red Smoke)</p>
<div class="w-full bg-surface-container rounded-full h-2">
<div class="bg-primary h-2 rounded-full" style="width: 15%"></div>
</div>
</div>
</div>
</section>
<!-- Other Breeds Section -->
<section class="mb-xl bg-surface-container-low p-lg rounded-2xl border border-outline-variant/20">
<div class="flex items-center justify-between mb-lg">
<h2 class="text-headline-md font-headline-md text-on-surface">Explore Other Breeds</h2>
<a class="text-primary font-bold text-label-md flex items-center gap-1 hover:underline"  href="/maine-coon-color-calculator/">
                    View All <span class="material-symbols-outlined">arrow_forward</span>
</a>
</div>
<div class="flex gap-md overflow-x-auto pb-md custom-scrollbar">
<div class="flex-shrink-0 w-48 tonal-layer-1 p-md rounded-xl text-center group cursor-pointer hover:bg-surface-container-high transition-colors">
<div class="w-20 h-20 bg-secondary-fixed-dim rounded-full mx-auto mb-md flex items-center justify-center">
<span class="material-symbols-outlined text-[40px] text-on-secondary-fixed">pets</span>
</div>
<span class="font-bold text-on-surface block">Maine Coon</span>
<span class="text-label-sm text-on-surface-variant">Wild Patterns</span>
</div>
<div class="flex-shrink-0 w-48 tonal-layer-1 p-md rounded-xl text-center group cursor-pointer hover:bg-surface-container-high transition-colors">
<div class="w-20 h-20 bg-secondary-fixed-dim rounded-full mx-auto mb-md flex items-center justify-center">
<span class="material-symbols-outlined text-[40px] text-on-secondary-fixed">pets</span>
</div>
<span class="font-bold text-on-surface block">British Shorthair</span>
<span class="text-label-sm text-on-surface-variant">Blue Genetics</span>
</div>
<a href="/bengal-cat-color-calculator/" class="flex-shrink-0 w-48 tonal-layer-1 p-md rounded-xl text-center hover:bg-surface-container-high transition-colors">
<span class="font-bold text-on-surface block">Bengal</span>
<span class="text-label-sm text-on-surface-variant">Spotted notes</span>
</a>
</div>
</section>
  </main>
  <Footer />
  <style is:global>
.material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .tonal-layer-1 {
            background-color: #ffffff;
            border: 1px solid #e0d8c8;
            box-shadow: 0px 4px 20px rgba(42, 42, 42, 0.05);
        }
        .tonal-layer-2 {
            box-shadow: 0px 8px 30px rgba(42, 42, 42, 0.08);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #e0d8c8;
            border-radius: 10px;
        }
  </style>
</Layout>
