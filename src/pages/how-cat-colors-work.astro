---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Feline Genetics Guide - How Cat Colors Work';
const description = 'Plain-language guide to cat coat genes: B, A, O, and D — the same four loci used in our free calculator.';
---
<Layout title={title} description={description}>
  <Header active="guide" />
  <main class="max-w-container-max mx-auto px-lg md:px-xl py-xl space-y-xl">
    <header class="text-center max-w-2xl mx-auto space-y-md">
      <h1 class="text-display-lg font-display-lg text-primary">How cat colors work</h1>
      <p class="text-body-lg text-on-surface-variant">
        A short tour of the four genes this site actually calculates. Flip the switches to preview a simplified phenotype image.
      </p>
    </header>

    <section class="grid grid-cols-1 lg:grid-cols-12 gap-xl items-start" id="gene-demo">
      <div class="lg:col-span-5 space-y-md">
        <div class="p-lg rounded-2xl bg-surface-container-lowest border border-outline-variant/40 card-shadow space-y-lg">
          <h2 class="text-headline-md font-headline-md text-primary">Preview controls</h2>

          <div>
            <p class="text-label-md font-bold mb-sm">Agouti (A)</p>
            <div class="flex gap-sm" data-gene="A">
              <button type="button" data-val="A" class="gene-btn flex-1 py-2 rounded-full text-sm font-semibold border-2 gene-on">Tabby (A-)</button>
              <button type="button" data-val="a" class="gene-btn flex-1 py-2 rounded-full text-sm font-semibold border-2 gene-off">Solid (aa)</button>
            </div>
          </div>
          <div>
            <p class="text-label-md font-bold mb-sm">Dilute (D)</p>
            <div class="flex gap-sm" data-gene="D">
              <button type="button" data-val="D" class="gene-btn flex-1 py-2 rounded-full text-sm font-semibold border-2 gene-on">Dense (D-)</button>
              <button type="button" data-val="d" class="gene-btn flex-1 py-2 rounded-full text-sm font-semibold border-2 gene-off">Dilute (dd)</button>
            </div>
          </div>
          <div>
            <p class="text-label-md font-bold mb-sm">Orange (O) — simplified as full orange vs not</p>
            <div class="flex gap-sm" data-gene="O">
              <button type="button" data-val="o" class="gene-btn flex-1 py-2 rounded-full text-sm font-semibold border-2 gene-on">Not orange</button>
              <button type="button" data-val="O" class="gene-btn flex-1 py-2 rounded-full text-sm font-semibold border-2 gene-off">Orange</button>
            </div>
          </div>
          <p class="text-sm text-on-surface-variant">This demo is illustrative only (black series fixed as black). Use the <a class="text-primary font-bold underline" href="/">calculator</a> for litter probabilities with carriers.</p>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="rounded-2xl overflow-hidden border border-outline-variant/40 card-shadow bg-surface-container-low p-lg">
          <div class="aspect-[4/3] rounded-xl overflow-hidden bg-surface-dim">
            <img id="cat-image" src="/images/cats/brown-tabby/0.jpg" alt="Example coat color" class="w-full h-full object-cover" width="800" height="600" />
          </div>
          <div class="mt-md flex justify-between items-end gap-md">
            <div>
              <h3 class="text-headline-md font-headline-md text-primary" id="phenotype-label">Brown Tabby</h3>
              <p class="text-sm text-on-surface-variant font-mono" id="genotype-desc">A- D- non-orange · black series</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-3xl space-y-lg border-t border-outline-variant/30 pt-xl">
      <h2 class="text-headline-lg font-headline-lg text-primary">The four primary genes</h2>
      <div class="space-y-md text-body-md text-on-surface-variant leading-relaxed">
        <p><strong class="text-on-surface">B series:</strong> Controls black-type pigment. B (black) dominates b (chocolate) and bl (cinnamon).</p>
        <p><strong class="text-on-surface">Agouti (A):</strong> A- allows tabby banding; aa is solid. Ghost striping on solids is common in kittens.</p>
        <p><strong class="text-on-surface">Orange (O):</strong> On the X chromosome. Males need one O to be red; females with Oo are tortoiseshell. Red usually looks tabby.</p>
        <p><strong class="text-on-surface">Dilute (d):</strong> Recessive. Black→blue, chocolate→lilac, cinnamon→fawn, red→cream. Both parents must pass d for a dilute kitten.</p>
      </div>
      <p class="text-body-md text-on-surface-variant">
        Not covered here: white spotting (calico/bicolor), silver/smoke (I), colorpoint (cs/cb), amber (e), or tabby pattern subtype. Those need extra loci or DNA tests.
      </p>
      <a href="/" class="btn-primary inline-flex">Open the calculator</a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .gene-on {
    background: #8d4b00;
    color: #fff;
    border-color: #6e3900;
  }
  .gene-off {
    background: #f7f3df;
    color: #725d42;
    border-color: #c4b89e;
  }
</style>

<script>
  type State = { A: 'A' | 'a'; D: 'D' | 'd'; O: 'O' | 'o' };
  const state: State = { A: 'A', D: 'D', O: 'o' };

  const PRESETS: Record<string, { img: string; label: string; desc: string }> = {
    'A-D-o': { img: '/images/cats/brown-tabby/0.jpg', label: 'Brown Tabby', desc: 'A- D- non-orange · black series' },
    'A-d-o': { img: '/images/cats/blue/0.jpg', label: 'Blue Tabby', desc: 'A- dd non-orange · dilute black' },
    'a-D-o': { img: '/images/cats/black/0.jpg', label: 'Solid Black', desc: 'aa D- non-orange · black series' },
    'a-d-o': { img: '/images/cats/blue/0.jpg', label: 'Solid Blue', desc: 'aa dd non-orange · dilute' },
    'A-D-O': { img: '/images/cats/red-tabby/0.jpg', label: 'Red Tabby', desc: 'Orange (simplified full orange)' },
    'A-d-O': { img: '/images/cats/cream/0.jpg', label: 'Cream Tabby', desc: 'Orange + dilute' },
    'a-D-O': { img: '/images/cats/red-tabby/0.jpg', label: 'Red (looks tabby)', desc: 'Orange often shows tabby even if aa' },
    'a-d-O': { img: '/images/cats/cream/0.jpg', label: 'Cream', desc: 'Orange + dilute' },
  };

  function key() {
    return `${state.A}-${state.D}-${state.O}`;
  }

  function apply() {
    const p = PRESETS[key()] || PRESETS['A-D-o'];
    const img = document.getElementById('cat-image') as HTMLImageElement | null;
    const label = document.getElementById('phenotype-label');
    const desc = document.getElementById('genotype-desc');
    if (img) { img.src = p.img; img.alt = p.label; }
    if (label) label.textContent = p.label;
    if (desc) desc.textContent = p.desc;

    document.querySelectorAll('[data-gene]').forEach((group) => {
      const g = (group as HTMLElement).dataset.gene as keyof State;
      group.querySelectorAll('.gene-btn').forEach((btn) => {
        const on = (btn as HTMLElement).dataset.val === state[g];
        btn.classList.toggle('gene-on', on);
        btn.classList.toggle('gene-off', !on);
      });
    });
  }

  function boot() {
    document.querySelectorAll('[data-gene] .gene-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.closest('[data-gene]') as HTMLElement;
        const g = group.dataset.gene as keyof State;
        state[g] = (btn as HTMLElement).dataset.val as any;
        apply();
      });
    });
    apply();
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
