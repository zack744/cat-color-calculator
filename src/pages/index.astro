---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CatColorCalculator from '../components/CatColorCalculator.astro';

const title = 'Cat Color Calculator - Predict Kitten Coat Colors | Free Tool';
const description = 'Free cat color calculator. Predict kitten coat colors and genetics from parent cats. Supports Maine Coon, British Shorthair, Persian, Bengal. Pure client-side, no signup.';

const examples = [
  { name: 'Solid Black', genotype: 'B/B, aa, D/D, o/y', note: 'Common Outcome', image: '/images/cats/black/0.jpg' },
  { name: 'Blue (Dilute)', genotype: 'B/B, aa, d/d, o/y', note: 'Dilute Gene Result', image: '/images/cats/blue/0.jpg' },
  { name: 'Red Tabby', genotype: 'B/-, A/-, D/-, O/y', note: 'Sex-Linked Gene', image: '/images/cats/red-tabby/0.jpg' },
  { name: 'Tortoiseshell', genotype: 'B/-, aa, D/-, O/o', note: 'Female Exclusive', image: '/images/cats/tortoiseshell/0.jpg' },
];

const breeds = [
  { name: 'Maine Coon', href: '/maine-coon-color-calculator/', icon: 'forest', desc: "Specializing in Smokes, Silvers, and classic Tabby patterns common in the King of Cats." },
  { name: 'British Shorthair', href: '/british-shorthair-color-calculator/', icon: 'castle', desc: 'Focusing on the iconic Solid Blue and Lilac genetics of this noble, round-faced breed.' },
  { name: 'Persian', href: '/persian-cat-color-calculator/', icon: 'spa', desc: 'Genetic calculator for long-hair dilute shades, colorpoints, and bi-color patterns.' },
  { name: 'Bengal', href: '/bengal-cat-color-calculator/', icon: 'local_fire_department', desc: 'Unique insights into wild-cross genetics: Marbled, Spotted, and Charcoal variations.' },
];
---
<Layout title={title} description={description}>
  <Header active="calculator" />

  <main class="max-w-container-max mx-auto px-lg md:px-xl py-xl space-y-xl">
    <!-- Section 1: Hero + Calculator -->
    <header class="text-center space-y-md">
      <h1 class="text-display-lg font-display-lg text-on-surface leading-tight">Cat Color Calculator</h1>
      <p class="text-headline-md text-on-surface-variant">Predict Kitten Coat Colors</p>
      <p class="text-body-lg font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Discover the genetic possibilities of your next litter with our high-precision feline genetics engine.
        Simple, fast, and professional.
      </p>
    </header>

    <section>
      <CatColorCalculator variant="home" />
    </section>

    <!-- Section 2: Deep Dive Genetics -->
    <section class="py-xl">
      <div class="max-w-4xl mx-auto space-y-xl">
        <div class="text-center">
          <h2 class="text-headline-lg font-headline-lg mb-md">How Cat Color Genetics Work</h2>
          <p class="text-on-surface-variant">The science behind the beauty of every feline coat.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
          <div class="glass-card p-lg rounded-xl">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">The Extension Gene (B)</h3>
            <p class="text-body-md text-on-surface-variant">The base color of almost all cats is black. The B gene controls the shape of eumelanin granules. Dominant 'B' results in solid black, while recessive 'b' creates chocolate and 'bl' creates cinnamon. Understanding this hierarchy is the foundation of any color prediction.</p>
          </div>
          <div class="glass-card p-lg rounded-xl">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">The Agouti Gene (A)</h3>
            <p class="text-body-md text-on-surface-variant">Agouti determines if a cat has a "wild" tabby pattern or a solid color. The dominant 'A' gene allows for the development of stripes, spots, or whorls, while 'aa' (non-agouti) suppresses the pattern, resulting in a solid coat.</p>
          </div>
          <div class="glass-card p-lg rounded-xl">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">The Orange Gene (O)</h3>
            <p class="text-body-md text-on-surface-variant">Located on the X-chromosome, the Orange gene is sex-linked. This is why most ginger cats are male and tortoiseshells are almost exclusively female. If a female cat has one 'O' and one 'o' allele, she will be a tortoiseshell.</p>
          </div>
          <div class="glass-card p-lg rounded-xl">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">The Dilution Gene (D)</h3>
            <p class="text-body-md text-on-surface-variant">Dilution "washes out" the primary colors. Black becomes Blue (Grey), Chocolate becomes Lilac, Cinnamon becomes Fawn, and Orange becomes Cream. This recessive trait (dd) must be inherited from both parents to show.</p>
          </div>
        </div>

        <div class="bg-surface-container-high rounded-xl p-xl border border-outline-variant/30 text-center">
          <h4 class="text-headline-md font-headline-md mb-md">Genetic Case Study: Tortoiseshell Magic</h4>
          <p class="text-body-lg mb-lg">When you cross a <strong>Black Cat (Sire)</strong> with a <strong>Red/Orange Cat (Dam)</strong>, the resulting female kittens will almost always be <strong>Tortoiseshell</strong>.</p>
          <div class="flex flex-wrap justify-center gap-md items-center">
            <div class="px-6 py-3 bg-black text-white rounded-lg font-bold">Black Male</div>
            <span class="text-2xl font-bold">×</span>
            <div class="px-6 py-3 bg-orange-500 text-white rounded-lg font-bold">Red Female</div>
            <span class="text-2xl font-bold">=</span>
            <div class="px-6 py-3 bg-gradient-to-r from-black to-orange-400 text-white rounded-lg font-bold">100% Tortie Females</div>
          </div>
        </div>

        <div class="prose prose-on-surface max-w-none space-y-md text-on-surface-variant">
          <p>Feline coat genetics is a complex interplay of dominant and recessive traits. While our calculator covers the primary four genes, hundreds of other factors—like the White Spotting gene, the Siamese-point gene, and polygenetic modifiers—can affect the final phenotype. For example, a "Blue" cat isn't actually blue; it's a black cat with pigment granules that are clumped together, allowing more light to pass through, creating a grey appearance.</p>
          <p>Breeders often look for "hidden" recessives. A solid black cat might "carry" dilute, meaning they have a 'Dd' genotype. When bred to another carrier, 25% of their offspring will be dilute (Blue/Grey), even though neither parent shows that color. Our tool allows you to simulate these genotypes to find the hidden potential in your breeding pairs.</p>
        </div>
      </div>
    </section>

    <!-- Section 3: Example Outcomes -->
    <section class="space-y-lg">
      <h2 class="text-headline-lg font-headline-lg text-center">Example Kitten Color Outcomes</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-md">
        {examples.map((ex) => (
          <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl overflow-hidden hover:shadow-md transition-shadow group">
            <div class="h-40 bg-surface-container overflow-hidden">
              <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src={ex.image} alt={ex.name} loading="lazy" />
            </div>
            <div class="p-md space-y-2">
              <h4 class="font-bold text-on-surface">{ex.name}</h4>
              <p class="text-label-sm text-on-surface-variant">Genotype: {ex.genotype}</p>
              <div class="flex items-center gap-1 text-primary">
                <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
                <span class="text-xs font-bold">{ex.note}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 4: By Breed -->
    <section class="space-y-lg py-xl border-t border-outline-variant/30">
      <h2 class="text-headline-lg font-headline-lg text-center">Breed-Specific Genetics</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-lg">
        {breeds.map((b) => (
          <div class="bg-surface-container-low p-lg rounded-xl border border-outline-variant/20 flex flex-col items-center text-center space-y-md">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-3xl">{b.icon}</span>
            </div>
            <h3 class="text-headline-md font-headline-md">{b.name}</h3>
            <p class="text-body-md text-on-surface-variant">{b.desc}</p>
            <a class="text-primary font-bold hover:underline flex items-center gap-1" href={b.href}>
              Explore Breed <span class="material-symbols-outlined text-sm">arrow_forward</span>
            </a>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <div class="sr-only" aria-hidden="true">
    <h2>Cat Color Genetics Calculator</h2>
    <p>
      Free online cat color calculator for predicting kitten coat colors from parent genetics.
      Calculate coat color probabilities for Maine Coon, British Shorthair, Persian, and Bengal breeds.
      Our feline genetics tool covers the four primary genes: Black (B), Agouti (A), Orange (O), and Dilution (D).
      Predict tortoiseshell, tabby, calico, solid black, blue, red, cream, smoke, silver, and colorpoint kittens.
    </p>
  </div>

  <style is:global>
    .glass-card {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(224, 216, 200, 0.5);
    }
    .card-shadow { box-shadow: 0px 4px 20px rgba(42, 42, 42, 0.05); }
    .meter-fill { transition: width 1s ease-out; }
  </style>
</Layout>
