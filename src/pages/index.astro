---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CatColorCalculator from '../components/CatColorCalculator.astro';

const title = 'Cat Color Calculator - Predict Kitten Coat Colors | Free Tool';
const description = 'Free Mendelian cat color calculator. Enter parent genotypes (including carriers) to estimate kitten coat colors. Covers B, A, O, and D loci.';

const examples = [
  { name: 'Solid Black', genotype: 'BB aa DD oY', note: 'Dense black solid', image: '/images/cats/black/0.jpg' },
  { name: 'Blue (Dilute)', genotype: 'BB aa dd oY', note: 'Black + dilute', image: '/images/cats/blue/0.jpg' },
  { name: 'Red Tabby', genotype: '— A- D- OY', note: 'Orange on X', image: '/images/cats/red-tabby/0.jpg' },
  { name: 'Tortoiseshell', genotype: '— aa D- Oo', note: 'Females (Oo)', image: '/images/cats/tortoiseshell/0.jpg' },
];

const breeds = [
  { name: 'Maine Coon', href: '/maine-coon-color-calculator/', desc: 'Notes on tabby, dilute, and silver/smoke (silver not modeled).' },
  { name: 'British Shorthair', href: '/british-shorthair-color-calculator/', desc: 'Blue and lilac dilute solid colors explained.' },
  { name: 'Persian', href: '/persian-cat-color-calculator/', desc: 'Dilute and longhair context; white spotting not modeled.' },
  { name: 'Bengal', href: '/bengal-cat-color-calculator/', desc: 'Spotted/marble notes; snow & charcoal not modeled.' },
];
---
<Layout title={title} description={description}>
  <Header active="calculator" />

  <main class="max-w-container-max mx-auto px-lg md:px-xl py-xl space-y-xl">
    <header class="text-center space-y-md max-w-2xl mx-auto">
      <h1 class="text-display-lg font-display-lg text-on-surface leading-tight">Cat Color Calculator</h1>
      <p class="text-body-lg text-on-surface-variant">
        Estimate kitten coat colors from parent genotypes. Four loci only: black series (B), agouti (A), dilute (D), and orange (O). Free, runs in your browser.
      </p>
      <ol class="flex flex-wrap justify-center gap-3 text-sm text-on-surface-variant pt-sm">
        <li class="px-3 py-1 rounded-full bg-parchment border border-outline-variant">1. Set sire</li>
        <li class="px-3 py-1 rounded-full bg-parchment border border-outline-variant">2. Set dam</li>
        <li class="px-3 py-1 rounded-full bg-parchment border border-outline-variant">3. Read outcomes</li>
      </ol>
    </header>

    <section>
      <CatColorCalculator variant="home" />
    </section>

    <section class="py-xl">
      <div class="max-w-4xl mx-auto space-y-xl">
        <div class="text-center">
          <h2 class="text-headline-lg font-headline-lg mb-md">The four genes we model</h2>
          <p class="text-on-surface-variant">Same loci as the calculator inputs. Carriers (heterozygotes) are included.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
          <div class="p-lg rounded-2xl bg-surface-container-lowest border border-outline-variant/40 card-shadow">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">B — Black series</h3>
            <p class="text-body-md text-on-surface-variant">Allele order B &gt; b &gt; bl. Black, chocolate, or cinnamon pigment; dilute turns them blue, lilac, or fawn.</p>
          </div>
          <div class="p-lg rounded-2xl bg-surface-container-lowest border border-outline-variant/40 card-shadow">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">A — Agouti</h3>
            <p class="text-body-md text-on-surface-variant">A- shows tabby banding; aa is solid (non-agouti). Two tabby carriers (Aa × Aa) can still produce solids.</p>
          </div>
          <div class="p-lg rounded-2xl bg-surface-container-lowest border border-outline-variant/40 card-shadow">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">O — Orange (X-linked)</h3>
            <p class="text-body-md text-on-surface-variant">Males are O/Y or o/Y. Females OO, Oo (tortie), or oo. Most red cats look tabby even when genetically solid.</p>
          </div>
          <div class="p-lg rounded-2xl bg-surface-container-lowest border border-outline-variant/40 card-shadow">
            <h3 class="text-headline-md font-headline-md text-primary mb-md">D — Dilute</h3>
            <p class="text-body-md text-on-surface-variant">Recessive dd lightens pigment. Two dense cats that are both Dd can produce about 25% dilute kittens.</p>
          </div>
        </div>

        <div class="bg-surface-container rounded-2xl p-xl border border-outline-variant/40">
          <h3 class="text-headline-md font-headline-md mb-md">Example: black male × red female</h3>
          <p class="text-body-md text-on-surface-variant mb-lg">
            With a non-orange black sire (o/Y) and a red dam (O/O or O/-), daughters typically get orange from the dam and non-orange from the sire → <strong class="text-on-surface">tortoiseshell females</strong>. Sons get the dam’s X → often red males. Exact % depends on the full genotypes you enter above.
          </p>
          <div class="flex flex-wrap gap-md items-center text-sm font-semibold">
            <span class="px-4 py-2 bg-on-surface text-white rounded-full">Black sire</span>
            <span>×</span>
            <span class="px-4 py-2 bg-primary text-white rounded-full">Red dam</span>
            <span>→</span>
            <span class="px-4 py-2 bg-parchment border border-outline-variant rounded-full text-on-surface">Often tortie ♀ + red ♂</span>
          </div>
        </div>

        <p class="text-body-md text-on-surface-variant leading-relaxed">
          White spotting (bicolor/calico), silver/smoke, colorpoint, and tabby pattern type (classic vs mackerel vs spotted) are <strong class="text-on-surface">not</strong> in this model. For breeding decisions, confirm with DNA panels and your registry.
        </p>
      </div>
    </section>

    <section class="space-y-lg">
      <h2 class="text-headline-lg font-headline-lg text-center">Common phenotypes</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-md">
        {examples.map((ex) => (
          <div class="bg-surface-container-lowest border border-outline-variant/40 rounded-2xl overflow-hidden card-shadow">
            <div class="h-36 bg-surface-container overflow-hidden">
              <img class="w-full h-full object-cover" src={ex.image} alt={ex.name} loading="lazy" width="400" height="300" />
            </div>
            <div class="p-md space-y-1">
              <h3 class="font-bold text-on-surface">{ex.name}</h3>
              <p class="text-xs font-mono text-on-surface-variant">{ex.genotype}</p>
              <p class="text-sm text-on-surface-variant">{ex.note}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-lg py-xl border-t border-outline-variant/30">
      <h2 class="text-headline-lg font-headline-lg text-center">Breed pages</h2>
      <p class="text-center text-on-surface-variant max-w-xl mx-auto text-body-md">
        Same calculator on every breed page — with notes about colors people ask about for that breed.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-lg">
        {breeds.map((b) => (
          <a href={b.href} class="block bg-surface-container-low p-lg rounded-2xl border border-outline-variant/30 hover:border-primary/40 transition-colors space-y-sm">
            <h3 class="text-headline-md font-headline-md text-on-surface">{b.name}</h3>
            <p class="text-sm text-on-surface-variant">{b.desc}</p>
            <span class="text-primary text-sm font-bold">Open →</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
