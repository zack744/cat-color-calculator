---
interface Props {
  active?: 'calculator' | 'breeds' | 'chart' | 'guide' | 'privacy';
}
const { active = 'calculator' } = Astro.props;

const link = (key: string, href: string, label: string) => {
  const isActive = active === key;
  return { href, label, isActive };
};

const links = [
  link('calculator', '/', 'Calculator'),
  link('breeds', '/maine-coon-color-calculator/', 'Breeds'),
  link('chart', '/cat-color-chart/', 'Color Chart'),
  link('guide', '/how-cat-colors-work/', 'Guide'),
];
---
<nav class="bg-surface/80 backdrop-blur-md sticky top-0 z-50 border-b border-outline-variant/30 shadow-sm">
  <div class="flex justify-between items-center w-full px-lg md:px-xl max-w-container-max mx-auto py-md">
    <a href="/" class="text-headline-md font-headline-md font-bold text-primary flex items-center gap-2">
      <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">pets</span>
      Cat Color Calculator
    </a>
    <div class="hidden md:flex items-center gap-lg">
      {links.map((l) => (
        <a
          class:list={[
            'text-label-md font-label-md transition-colors',
            l.isActive
              ? 'text-primary font-bold border-b-2 border-primary pb-1'
              : 'text-on-surface-variant hover:text-primary',
          ]}
          href={l.href}
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>
</nav>
