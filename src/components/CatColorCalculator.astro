---
interface Props {
  variant?: 'home' | 'breed';
  breed?: string;
  note?: string;
}
const {
  variant = 'home',
  breed = 'general',
  note = 'Model covers B (black series), A (agouti), D (dilute), and O (orange/X). Not included: white spotting, silver/smoke, colorpoint, tabby pattern type. Use DNA tests when decisions matter.',
} = Astro.props;

const isHome = variant === 'home';
const formId = `calc-form-${breed}-${variant}`;
const resultsId = `calc-results-${breed}-${variant}`;

const selectClass =
  'w-full rounded-full border-2 border-outline-variant bg-surface-container-low px-4 py-2.5 text-body-md text-on-surface focus:border-focus focus:ring-2 focus:ring-focus/20 outline-none transition-shadow';
const labelClass = 'text-label-md font-label-md text-on-surface-variant';
---
<div class="calc-root" data-variant={variant} data-breed={breed} data-form-id={formId} data-results-id={resultsId}>
  <div class:list={[isHome ? 'grid grid-cols-1 lg:grid-cols-12 gap-lg items-start' : 'grid grid-cols-1 lg:grid-cols-3 gap-lg items-start']}>
    <div class:list={[
      isHome
        ? 'lg:col-span-8 bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant/40 card-shadow space-y-lg'
        : 'lg:col-span-2 bg-surface-container-lowest rounded-2xl border border-outline-variant/40 p-lg card-shadow space-y-lg',
    ]}>
      <form id={formId} class="space-y-lg" novalidate>
        <p class="text-sm text-on-surface-variant leading-relaxed">
          Pick genotypes for each parent. <strong class="text-on-surface">Carrier</strong> options (e.g. Dd, Aa, Bb) matter — two dense carriers can still produce dilute kittens.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-xl">
          <div class="space-y-md">
            <h3 class="text-headline-md font-headline-md text-primary">Sire (Father)</h3>
            <div class="space-y-md">
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-sire_B`}>Black series (B &gt; b &gt; bl)</label>
                <select id={`${formId}-sire_B`} name="sire_B" class={selectClass}>
                  <option value="BB">Black BB</option>
                  <option value="Bb">Black, carries chocolate (Bb)</option>
                  <option value="Bbl">Black, carries cinnamon (B/bl)</option>
                  <option value="bb">Chocolate bb</option>
                  <option value="bbl">Chocolate, carries cinnamon (b/bl)</option>
                  <option value="blbl">Cinnamon bl/bl</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-sire_A`}>Agouti (tabby vs solid)</label>
                <select id={`${formId}-sire_A`} name="sire_A" class={selectClass}>
                  <option value="aa">Solid aa</option>
                  <option value="Aa">Tabby, carries solid (Aa)</option>
                  <option value="AA">Tabby AA</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-sire_O`}>Orange (X-linked)</label>
                <select id={`${formId}-sire_O`} name="sire_O" class={selectClass}>
                  <option value="oY">Not orange (o/Y)</option>
                  <option value="OY">Orange (O/Y)</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-sire_D`}>Dilute</label>
                <select id={`${formId}-sire_D`} name="sire_D" class={selectClass}>
                  <option value="DD">Dense DD</option>
                  <option value="Dd">Dense, carries dilute (Dd)</option>
                  <option value="dd">Dilute dd</option>
                </select>
              </div>
            </div>
          </div>

          <div class="space-y-md">
            <h3 class="text-headline-md font-headline-md text-on-secondary-container">Dam (Mother)</h3>
            <div class="space-y-md">
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-dam_B`}>Black series (B &gt; b &gt; bl)</label>
                <select id={`${formId}-dam_B`} name="dam_B" class={selectClass}>
                  <option value="BB">Black BB</option>
                  <option value="Bb">Black, carries chocolate (Bb)</option>
                  <option value="Bbl">Black, carries cinnamon (B/bl)</option>
                  <option value="bb">Chocolate bb</option>
                  <option value="bbl">Chocolate, carries cinnamon (b/bl)</option>
                  <option value="blbl">Cinnamon bl/bl</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-dam_A`}>Agouti (tabby vs solid)</label>
                <select id={`${formId}-dam_A`} name="dam_A" class={selectClass}>
                  <option value="Aa" selected>Tabby, carries solid (Aa)</option>
                  <option value="AA">Tabby AA</option>
                  <option value="aa">Solid aa</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-dam_O`}>Orange (X-linked)</label>
                <select id={`${formId}-dam_O`} name="dam_O" class={selectClass}>
                  <option value="Oo" selected>Tortoiseshell (Oo)</option>
                  <option value="oo">Not orange (oo)</option>
                  <option value="OO">Orange (OO)</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class={labelClass} for={`${formId}-dam_D`}>Dilute</label>
                <select id={`${formId}-dam_D`} name="dam_D" class={selectClass}>
                  <option value="dd" selected>Dilute dd</option>
                  <option value="Dd">Dense, carries dilute (Dd)</option>
                  <option value="DD">Dense DD</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <div class:list={[isHome ? 'pt-md flex flex-wrap gap-3 justify-center' : 'flex flex-col gap-2']}>
          <button type="submit" class="btn-primary">
            Calculate kitten colors
          </button>
          <button type="button" class="btn-secondary copy-results-btn" data-results={resultsId}>
            Copy results
          </button>
        </div>
      </form>
    </div>

    <div class:list={[isHome ? 'lg:col-span-4 space-y-md' : '']}>
      <div class:list={[
        isHome
          ? 'bg-secondary-container rounded-2xl p-lg border border-outline-variant/40 card-shadow h-full'
          : 'bg-surface-container-high rounded-2xl border border-outline-variant/40 p-lg space-y-md h-full',
      ]}>
        <h3 class="text-headline-md font-headline-md text-on-secondary-container mb-sm">
          Kitten outcomes
        </h3>
        <p class="text-sm text-on-surface-variant mb-md parent-summary" id={`${resultsId}-summary`}></p>
        <div id={resultsId} class="space-y-md" aria-live="polite">
          <p class="text-sm text-on-surface-variant">Loading…</p>
        </div>
        <div class="mt-lg pt-md border-t border-on-secondary-container/15">
          <p class="text-sm text-on-surface-variant leading-relaxed">{note}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    calculateKittenColors,
    colorSwatch,
    type ParentGenes,
    type Outcome,
    type BKey,
    type AKey,
    type DKey,
    type OKey,
  } from '../scripts/genetics';

  function readParent(form: HTMLFormElement, prefix: 'sire' | 'dam'): ParentGenes {
    const get = (n: string) =>
      (form.querySelector(`[name="${prefix}_${n}"]`) as HTMLSelectElement | null)?.value ?? '';
    return {
      B: get('B') as BKey,
      A: get('A') as AKey,
      O: get('O') as OKey,
      D: get('D') as DKey,
    };
  }

  function fmtPct(p: number): string {
    const x = p * 100;
    if (x >= 10) return `${Math.round(x * 10) / 10}%`;
    if (x >= 1) return `${Math.round(x * 10) / 10}%`;
    return `${Math.round(x * 100) / 100}%`;
  }

  function renderResults(el: HTMLElement, summaryEl: HTMLElement | null, results: Outcome[], sire: ParentGenes, dam: ParentGenes) {
    if (summaryEl) {
      summaryEl.textContent = `Sire ${sire.B} ${sire.A} ${sire.O} ${sire.D}  ·  Dam ${dam.B} ${dam.A} ${dam.O} ${dam.D}`;
    }
    if (!results.length) {
      el.innerHTML = '<p class="text-sm text-on-surface-variant">No outcomes — check genotypes.</p>';
      return;
    }
    const total = results.reduce((s, r) => s + r.probability, 0) || 1;
    el.innerHTML = results
      .map((r, i) => {
        const pct = r.probability / total;
        const width = Math.min(pct * 100, 100);
        const sex = r.sex === 'M' ? '♂' : '♀';
        const swatch = colorSwatch(r.color);
        const top = i < 3 ? 'font-bold' : 'font-medium';
        return `<div class="space-y-1">
          <div class="flex justify-between gap-2 text-sm ${top} text-on-surface tabular-nums">
            <span class="flex items-center gap-2 min-w-0">
              <span class="inline-block w-3 h-3 rounded-full shrink-0 border border-black/10" style="background:${swatch}"></span>
              <span class="truncate">${r.color} <span class="text-on-surface-variant font-normal">${sex}</span></span>
            </span>
            <span class="shrink-0">${fmtPct(pct)}</span>
          </div>
          <div class="w-full h-2.5 rounded-full overflow-hidden bg-parchment border border-outline-variant/50">
            <div class="h-full rounded-full meter-fill" style="width:${width}%;background:${swatch}"></div>
          </div>
          <p class="text-xs text-on-surface-variant/80 font-mono truncate">${r.genotype}</p>
        </div>`;
      })
      .join('');
    el.dataset.copyText = results
      .map((r) => `${r.color} (${r.sex}) ${fmtPct(r.probability / total)} — ${r.genotype}`)
      .join('\n');
  }

  function initRoot(root: HTMLElement) {
    const formId = root.dataset.formId!;
    const resultsId = root.dataset.resultsId!;
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const resultsEl = document.getElementById(resultsId);
    const summaryEl = document.getElementById(`${resultsId}-summary`);
    if (!form || !resultsEl) return;

    const run = () => {
      const sire = readParent(form, 'sire');
      const dam = readParent(form, 'dam');
      renderResults(resultsEl, summaryEl, calculateKittenColors(sire, dam), sire, dam);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run();
    });
    form.addEventListener('change', run);

    root.querySelector('.copy-results-btn')?.addEventListener('click', async () => {
      const text = resultsEl.dataset.copyText || resultsEl.innerText;
      try {
        await navigator.clipboard.writeText(text);
        const btn = root.querySelector('.copy-results-btn');
        if (btn) {
          const old = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = old; }, 1500);
        }
      } catch { /* ignore */ }
    });

    run();
  }

  function boot() {
    document.querySelectorAll<HTMLElement>('.calc-root').forEach(initRoot);
  }
  boot();
  document.addEventListener('astro:page-load', boot);
</script>
